{
  "manifest_version": 3,
  "name": "Vega",
  "version": "0.2.0",
  "description": "Lets the local VoiceAssist voice helper read pages, control tabs and HTML5 video for a blind user.",
  "minimum_chrome_version": "88",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "scripting",
    "bookmarks",
    "history",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "worker.js"
  }
}
